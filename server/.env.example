PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Either set DATABASE_URL...
DATABASE_URL=postgres://postgres:postgres@localhost:5432/styletransfer
PGSSL=false

# ...or the discrete vars below (used only when DATABASE_URL is unset)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=styletransfer
